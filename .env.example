# Copy to .env (gitignored) and edit. Every field in config.py can be set here or as an environment
# variable; environment variables win. Defaults shown are the ones in config.py unless noted.

# --- Agent LLM: any OpenAI-compatible /chat/completions server with tool calling ---------------
# Local vLLM started by scripts/serve_llm.sh (the setup used in Experiments 7-14):
NVIDIA_NIM_API_BASE=http://localhost:8011/v1
NVIDIA_NIM_MODEL=qwen3.5-9b
NVIDIA_NIM_API_KEY=local
# Hosted NVIDIA NIM instead:
# NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_NIM_API_KEY=nvapi-...
LLM_TIMEOUT_S=120

# --- Write gate --------------------------------------------------------------------------------
# deberta (local NLI, default) | llm (OpenAI-compatible server) | nemoguard (JailbreakDetect server)
WRITE_GATE_CLASSIFIER=deberta
# config.py default is cpu
DEVICE=cuda
# For WRITE_GATE_CLASSIFIER=llm (default to NVIDIA_NIM_API_BASE / NVIDIA_NIM_MODEL):
# WRITE_GATE_LLM_API_BASE=http://localhost:8012/v1
# WRITE_GATE_LLM_MODEL=qwen3.5-4b
# For WRITE_GATE_CLASSIFIER=nemoguard and the nemo_rails arm:
# JAILBREAK_DETECT_URL=http://localhost:1337/model

# --- Signing key for provenance envelopes (change for anything shared) -------------------------
# SECRET_SIGNING_KEY=change-me

# --- Storage -----------------------------------------------------------------------------------
# In-memory by default; or point at a Qdrant server with QDRANT_URL=http://localhost:6333
# QDRANT_LOCATION=:memory:
# BANK_DB_PATH=:memory:
# LINEAGE_DB_PATH=memguard_lineage.json
